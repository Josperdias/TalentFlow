# MODELO. Ative copiando para .github/dependabot.yml SOMENTE depois que existir a branch main protegida
# (setup-github.sh). Sem main, o Dependabot abre PRs contra a branch padrão atual (foi o que aconteceu).
# Sugestão: limitar PRs abertos para não gerar ruído.
version: 2
updates:
  - { package-ecosystem: pip, directory: /services/api, schedule: { interval: weekly }, open-pull-requests-limit: 3 }
  - { package-ecosystem: npm, directory: /apps/web, schedule: { interval: weekly }, open-pull-requests-limit: 3 }
  - { package-ecosystem: gradle, directory: /apps/android, schedule: { interval: weekly }, open-pull-requests-limit: 3 }
  - { package-ecosystem: nuget, directory: /apps/windows, schedule: { interval: weekly }, open-pull-requests-limit: 3 }
  - { package-ecosystem: github-actions, directory: /, schedule: { interval: weekly }, open-pull-requests-limit: 3 }
