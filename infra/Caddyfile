# Proxy reverso com HTTPS automático (Let's Encrypt): serve o site e repassa /api/ para a API.
# SITE_ADDRESS vem do .env (ex.: meuhr.duckdns.org). O Caddy mantém o cabeçalho Host original, como a API exige.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"
	}

	handle /api/* {
		# instaladores (.exe/.apk) passam por aqui: sem limite de tempo de resposta
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv/site
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@nostore path / /index.html /config.json
		header @nostore Cache-Control "no-store"
		file_server
	}
}
