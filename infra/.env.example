# Copie para .env e preencha. NUNCA versione o .env nem coloque estes valores no site ou nos aplicativos.
PGDATABASE=talentflow
PGUSER=talentflow
# Gere uma senha longa e única (ex.: openssl rand -base64 32)
PGPASSWORD=
# Endereço público do site, sem barra final (ex.: https://rh.suaempresa.com.br). Necessário para o login.
TRUSTED_ORIGINS=
# Só se o site ficar em OUTRO domínio que a API (opção B do DEPLOY-WEB.md); caso contrário deixe vazio.
CORS_ORIGINS=

# --- Atualização automática dos aplicativos (Windows e Android) pelas Releases do GitHub ---
# Preencha com dono/repositorio (ex.: Josperdias/TalentFlow). Quando você PUBLICAR uma Release, os apps oferecem a atualização.
TF_UPDATES_GITHUB_REPO=
# Só se o repositório for PRIVADO: token fino do GitHub, somente leitura de "Contents" deste repositório. Nunca coloque em outro lugar.
TF_UPDATES_GITHUB_TOKEN=
# true = inclui pré-lançamentos (-rc); false = só versões finais
TF_UPDATES_PRERELEASES=true
