# Copie para .env e preencha. NUNCA versione o .env nem coloque estes valores no site ou nos aplicativos.
PGDATABASE=talentflow
PGUSER=talentflow
# Gere uma senha longa e única (ex.: openssl rand -base64 32)
PGPASSWORD=
# Endereço público do site, sem barra final (ex.: https://rh.suaempresa.com.br). Necessário para o login.
TRUSTED_ORIGINS=
# Só se o site ficar em OUTRO domínio que a API (opção B do DEPLOY-WEB.md); caso contrário deixe vazio.
CORS_ORIGINS=
