# TalentFlow People — Apache / cPanel (renomeie para .htaccess na pasta do site). EXEMPLO não validado em hospedagem real.
# Requer mod_headers e, para o proxy da API, mod_proxy + mod_proxy_http (se não houver, use API em outro domínio:
# veja DEPLOY-WEB.md, "Opção B").
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"
  <FilesMatch "^(index\.html|config\.json)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_proxy_http.c>
  ProxyPreserveHost On
  ProxyPass        "/api/" "http://127.0.0.1:8000/api/"
  ProxyPassReverse "/api/" "http://127.0.0.1:8000/api/"
</IfModule>
