# TalentFlow People — site estático + proxy da API (mesmo domínio). EXEMPLO: ajuste domínio, certificados e porta da API.
# NÃO foi validado em servidor de produção do proprietário; teste com `nginx -t` antes de recarregar.
server {
    listen 443 ssl http2;
    server_name rh.exemplo.com.br;                      # <- seu domínio
    ssl_certificate     /etc/letsencrypt/live/rh.exemplo.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rh.exemplo.com.br/privkey.pem;

    root /var/www/talentflow;                           # <- pasta onde você extraiu o ZIP
    index index.html;

    # Cabeçalhos de segurança (o site não carrega nada de terceiros).
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'" always;

    # Arquivos com hash no nome: cache longo. index.html e config.json: nunca em cache.
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
    location = /index.html { add_header Cache-Control "no-store"; }
    location = /config.json { add_header Cache-Control "no-store"; }

    # API: IMPORTANTE repassar o Host original (sem isso o login falha com "Origem inválida").
    location /api/ {
        proxy_pass http://127.0.0.1:8000;               # <- onde o backend (Docker) escuta
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 6m;                        # currículos de até 5 MB
    }

    # O site usa rotas com "#" (ex.: /#/vagas); não precisa de regra de reescrita (fallback) de SPA.
    location / { try_files $uri /index.html; }
}
server { listen 80; server_name rh.exemplo.com.br; return 301 https://$host$request_uri; }
